import 'package:flutter/material.dart';
import 'package:table_calendar/table_calendar.dart';
import '../services/caretaker_service.dart';
import 'package:intl/intl.dart';

class CaretakerCarlendar extends StatefulWidget {
  final String caretalerId; // *ระวังพิมพ์ผิดนะครับ ในโค้ดคุณใช้ caretalerId

  const CaretakerCarlendar({super.key, required this.caretalerId});

  @override
  State<CaretakerCarlendar> createState() => _CustomCalendarWidgetState();
}

class _CustomCalendarWidgetState extends State<CaretakerCarlendar> {
  CaretakerService caretakerService = CaretakerService();

  DateTime _focusedDay = DateTime.now();

  // 🌟 1. เพิ่มตัวแปรเก็บวันที่ที่ถูกจองแล้ว และสถานะการโหลด
  List<DateTime> _bookedDates = [];
  bool _isLoading = true;

  // สีที่ใช้ในหน้าปฏิทิน
  final Color primaryColor = const Color(0xFFA052BE);
  final Color availableBg = const Color(0xFFF0FAF3);
  final Color availableText = const Color(0xFF1B8749);
  final Color fullBg = const Color(0xFFFFF0F0);
  final Color fullText = const Color(0xFFD32F2F);
  final Color disabledBg = const Color(0xFFF5F5F5);
  final Color disabledText = const Color(0xFFBDBDBD);

  @override
  void initState() {
    super.initState();
    // 🌟 2. สั่งให้โหลดข้อมูลคิวงาทันทีที่เปิดหน้านี้
    _loadAppointments();
  }

  // 🌟 3. ฟังก์ชันโหลดข้อมูลจาก Service และเก็บใส่ List
  Future<void> _loadAppointments() async {
    try {
      final List<Map<dynamic, dynamic>> rawData = await caretakerService
          .getAppointmentDateFromRelative(widget.caretalerId);

      List<DateTime> dates = [];
      for (var item in rawData) {
        if (item['appointmentdate'] != null) {
          // ดึงค่า DateTime ออกมาเก็บไว้ใน List
          dates.add(item['appointmentdate'] as DateTime);
        }
      }

      // เมื่อดึงเสร็จแล้ว สั่งให้หน้าจอรีเฟรช และเอาป้าย Loading ออก
      setState(() {
        _bookedDates = dates;
        _isLoading = false;
      });
    } catch (e) {
      print("Error loading appointments: $e");
      setState(() {
        _isLoading = false;
      });
    }
  }

  // 🌟 4. แก้ฟังก์ชันเช็กสถานะ ให้เอาวันในปฏิทินไปเทียบกับวันในคิวงาน (_bookedDates)
  String _getDayStatus(DateTime day) {
    // ใช้คำสั่ง isSameDay (ของ table_calendar) เพื่อเทียบแค่วัน/เดือน/ปี (ไม่สนเวลา)
    bool isBooked = _bookedDates.any(
      (bookedDate) => isSameDay(bookedDate, day),
    );

    if (isBooked) {
      return 'full'; // ถ้าตรงกันแปลว่าวันนั้นเต็มแล้ว
    }
    return 'available'; // ถ้าไม่ตรงแปลว่าว่าง
  }

  @override
  Widget build(BuildContext context) {
    return Container(
      decoration: BoxDecoration(
        color: Colors.white,
        borderRadius: BorderRadius.circular(20),
        border: Border.all(color: Colors.black87, width: 1.5),
      ),
      child: Column(
        mainAxisSize: MainAxisSize.min,
        children: [
          // ส่วนหัวปฏิทิน (Header)
          Padding(
            padding: const EdgeInsets.only(
              left: 20,
              right: 8,
              top: 16,
              bottom: 8,
            ),
            child: Row(
              mainAxisAlignment: MainAxisAlignment.spaceBetween,
              children: [
                const Text(
                  'ตารางงาน',
                  style: TextStyle(fontSize: 18, fontWeight: FontWeight.bold),
                ),
                Row(
                  children: [
                    IconButton(
                      icon: const Icon(Icons.chevron_left, size: 28),
                      onPressed: () {
                        setState(() {
                          _focusedDay = DateTime(
                            _focusedDay.year,
                            _focusedDay.month - 1,
                            _focusedDay.day,
                          );
                        });
                      },
                    ),
                    SizedBox(
                      width: 80,
                      child: Text(
                        '${DateFormat('MMM', 'th').format(_focusedDay)} ${_focusedDay.year}',
                        textAlign: TextAlign.center,
                        style: const TextStyle(
                          fontSize: 16,
                          fontWeight: FontWeight.w600,
                        ),
                      ),
                    ),
                    IconButton(
                      icon: const Icon(Icons.chevron_right, size: 28),
                      onPressed: () {
                        setState(() {
                          _focusedDay = DateTime(
                            _focusedDay.year,
                            _focusedDay.month + 1,
                            _focusedDay.day,
                          );
                        });
                      },
                    ),
                  ],
                ),
              ],
            ),
          ),

          // 🌟 5. ครอบ TableCalendar ด้วย 조건ตรวจสอบว่ากำลังโหลดอยู่ไหม
          Padding(
            padding: const EdgeInsets.symmetric(horizontal: 12.0),
            child: _isLoading
                ? const SizedBox(
                    height: 250,
                    child: Center(
                      child: CircularProgressIndicator(),
                    ), // โชว์วงกลมโหลดรอ
                  )
                : TableCalendar(
                    locale: 'th_TH',
                    firstDay: DateTime.utc(2020, 1, 1),
                    lastDay: DateTime.utc(2030, 12, 31),
                    focusedDay: _focusedDay,
                    headerVisible: false,
                    daysOfWeekHeight: 40,
                    calendarBuilders: CalendarBuilders(
                      dowBuilder: (context, day) {
                        final text = DateFormat(
                          'E',
                          'th',
                        ).format(day).substring(0, 1);
                        String displayDow = text;
                        if (day.weekday == DateTime.thursday) displayDow = 'พฤ';
                        if (day.weekday == DateTime.sunday) displayDow = 'อา';
                        return Center(
                          child: Text(
                            displayDow,
                            style: TextStyle(
                              color: Colors.grey.shade600,
                              fontWeight: FontWeight.w500,
                            ),
                          ),
                        );
                      },
                      defaultBuilder: (context, day, focusedDay) {
                        String status = _getDayStatus(
                          day,
                        ); // เรียกเช็กสถานะที่นี่
                        return _buildCalendarCell(
                          day: day.day.toString(),
                          bgColor: status == 'available' ? availableBg : fullBg,
                          textColor: status == 'available'
                              ? availableText
                              : fullText,
                        );
                      },
                      todayBuilder: (context, day, focusedDay) {
                        // สมมติว่าอยากให้ "วันนี้" เปลี่ยนสีตามคิวงานด้วย ก็เช็กสถานะตรงนี้ได้
                        String status = _getDayStatus(day);
                        // ถ้าวันนี้เต็ม ก็โชว์สีแดง แต่ทำให้เข้มกว่าปกติเพื่อแยกกับวันอื่น
                        if (status == 'full') {
                          return _buildCalendarCell(
                            day: day.day.toString(),
                            bgColor: fullText.withValues(alpha: 0.8),
                            textColor: Colors.white,
                          );
                        }

                        return _buildCalendarCell(
                          day: day.day.toString(),
                          bgColor: primaryColor.withValues(alpha: 0.4),
                          textColor: Colors.white,
                        );
                      },
                      outsideBuilder: (context, day, focusedDay) {
                        return _buildCalendarCell(
                          day: day.day.toString(),
                          bgColor: disabledBg,
                          textColor: disabledText,
                        );
                      },
                    ),
                  ),
          ),

          const Divider(height: 30, thickness: 1, indent: 20, endIndent: 20),

          // แถบบอกความหมายสีด้านล่าง
          Padding(
            padding: const EdgeInsets.only(left: 20, bottom: 20),
            child: Row(
              children: [
                _buildLegendItem(
                  color: availableText,
                  label: 'ว่าง',
                  isBorder: true,
                ),
                const SizedBox(width: 16),
                _buildLegendItem(
                  color: fullText,
                  label: 'มีคิวงาน',
                  isBorder: true,
                ),
              ],
            ),
          ),
        ],
      ),
    );
  }

  Widget _buildCalendarCell({
    required String day,
    required Color bgColor,
    required Color textColor,
  }) {
    return Container(
      margin: const EdgeInsets.all(4.0),
      alignment: Alignment.center,
      decoration: BoxDecoration(
        color: bgColor,
        borderRadius: BorderRadius.circular(10),
      ),
      child: Text(
        day,
        style: TextStyle(
          color: textColor,
          fontWeight: FontWeight.w500,
          fontSize: 16,
        ),
      ),
    );
  }

  Widget _buildLegendItem({
    required Color color,
    required String label,
    required bool isBorder,
  }) {
    return Row(
      children: [
        Container(
          width: 20,
          height: 20,
          decoration: BoxDecoration(
            color: isBorder ? Colors.transparent : color.withValues(alpha: 0.7),
            borderRadius: BorderRadius.circular(6),
            border: Border.all(color: color, width: 1.5),
          ),
        ),
        const SizedBox(width: 8),
        Text(
          label,
          style: const TextStyle(fontSize: 14, fontWeight: FontWeight.w500),
        ),
      ],
    );
  }
}
</file>

<file path="widgets/custom_bottom_nav.dart">
import 'package:flutter/material.dart';
import 'package:firebase_auth/firebase_auth.dart';
import 'package:firebase_database/firebase_database.dart';

class CustomBottomNavBar extends StatefulWidget {
  final int currentIndex;
  final Function(int) onTap;
  final String uid;

  const CustomBottomNavBar({
    super.key,
    required this.currentIndex,
    required this.onTap,
    required this.uid,
  });

  @override
  State<CustomBottomNavBar> createState() => _CustomBottomNavBarState();
}

class _CustomBottomNavBarState extends State<CustomBottomNavBar> {
  int _unreadCount = 0;
  DatabaseReference? _dbRef;

  @override
  void initState() {
    super.initState();
    _startListeningToRequests(); // 🌟 เปลี่ยนมาใช้ระบบดักฟัง (Real-time)
  }

  void _startListeningToRequests() async {
    // 🌟 3. ใช้ UID ที่รับมาจาก Parameter แทน FirebaseAuth
    String uid = widget.uid;
    if (uid.isEmpty) return;

    // 1. ดึง caretakerId ของผู้ดูแลคนนี้ออกมาก่อน
    final caretakerSnap = await FirebaseDatabase.instance
        .ref('Login/$uid/Caretaker')
        .get();
    if (!caretakerSnap.exists) return;
    String myCaretakerId =
        (caretakerSnap.value as Map)['caretakerId']?.toString() ?? '';

    // 2. ตั้งค่าดักฟัง (Listener) กวาดหา Request ทั้งหมด
    _dbRef = FirebaseDatabase.instance.ref('Login');
    _dbRef!.onValue.listen((event) {
      if (!mounted) return;
      int count = 0;
      final data = event.snapshot.value as Map<dynamic, dynamic>?;

      if (data != null) {
        data.forEach((userUid, userEntry) {
          if (userEntry['Relative'] != null &&
              userEntry['Relative']['Request'] != null) {
            final requestsMap =
                userEntry['Relative']['Request'] as Map<dynamic, dynamic>;

            requestsMap.forEach((reqId, reqData) {
              if (reqData['caretakerId'] == myCaretakerId) {
                bool isRead = reqData['isReadCaretaker'] ?? false;
                String status = (reqData['requeststatus'] ?? '')
                    .toString()
                    .toLowerCase();

                // ==========================================
                // 🌟 ลอจิกใหม่: ปลุกแจ้งเตือน (Badge) เมื่อถึงเวลาบริการ
                // ==========================================
                if (status == 'accepted') {
                  String? dateStr = reqData['appointmentdate'];
                  // ใช้ตัวแปรนี้เช็คว่าเราเคยยิงเตือนรอบสองไปหรือยัง
                  bool hasTriggeredAlert =
                      reqData['hasTriggeredTimeAlert'] ?? false;

                  if (dateStr != null && !hasTriggeredAlert) {
                    DateTime? apptDate = DateTime.tryParse(dateStr);

                    // ถ้าเวลาปัจจุบัน เลยเวลานัดไปแล้ว
                    if (apptDate != null && DateTime.now().isAfter(apptDate)) {
                      // อัปเดตกลับไปที่ Firebase ให้เป็น Unread อีกครั้ง
                      FirebaseDatabase.instance
                          .ref('Login/$userUid/Relative/Request/$reqId')
                          .update({
                            'isReadCaretaker': false,
                            'hasTriggeredTimeAlert':
                                true, // มาร์คไว้ว่าปลุกแจ้งเตือนรอบสองไปแล้วนะ
                          });

                      // อัปเดตตัวแปรสำหรับนับ count ของ Badge ให้เด้งโชว์ทันที
                      isRead = false;
                    }
                  }
                }
                // ==========================================

                if ((status == 'pending' || status == 'accepted') && !isRead) {
                  count++;
                }
              }
            });
          }
        });
      }

      if (mounted) {
        setState(() {
          _unreadCount = count;
        });
      }
    });
  }

  @override
  Widget build(BuildContext context) {
    return BottomNavigationBar(
      currentIndex: widget.currentIndex,
      onTap: widget.onTap,
      backgroundColor: const Color(0xFF8E6FF0),
      type: BottomNavigationBarType.fixed,
      selectedItemColor: Colors.white,
      unselectedItemColor: Colors.white70,
      showUnselectedLabels: true,
      selectedLabelStyle: const TextStyle(
        fontWeight: FontWeight.bold,
        fontSize: 12,
      ),
      unselectedLabelStyle: const TextStyle(
        fontWeight: FontWeight.normal,
        fontSize: 12,
      ),
      items: [
        // 🌟 แท็บที่มีการแจ้งเตือน (ตกแต่ง Badge แบบในรูปเป๊ะๆ)
        BottomNavigationBarItem(
          icon: Badge(
            isLabelVisible: _unreadCount > 0, // ซ่อนถ้าเป็น 0
            backgroundColor: const Color(0xFFF44336), // สีแดงสดแจ้งเตือน
            padding: const EdgeInsets.symmetric(
              horizontal: 6,
              vertical: 2,
            ), // เพิ่มความอ้วนให้วงกลม
            label: Text(
              _unreadCount > 99 ? '99+' : _unreadCount.toString(),
              style: const TextStyle(
                color: Colors.white,
                fontWeight: FontWeight.bold,
                fontSize: 11,
              ),
            ),
            child: const Icon(Icons.support_agent, size: 28),
          ),
          label: 'ขอใช้บริการ',
        ),

        const BottomNavigationBarItem(
          icon: Icon(Icons.person_outline, size: 28),
          label: 'ผู้ดูแล',
        ),
      ],
    );
  }
}
</file>

