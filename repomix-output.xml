    required this.pointB,
    required this.routePoints,
    required this.distanceText,
    required this.maptilerApiKey,
  });

  @override
  Widget build(BuildContext context) {
    LatLng centerPoint = LatLng(
      (pointA.latitude + pointB.latitude) / 2,
      (pointA.longitude + pointB.longitude) / 2,
    );

    return Scaffold(
      appBar: AppBar(
        title: const Text(
          'แผนที่เส้นทาง',
          style: TextStyle(
            color: Colors.white,
            fontSize: 18,
            fontWeight: FontWeight.bold,
          ),
        ),
        backgroundColor: const Color(0xFFA052BE),
        iconTheme: const IconThemeData(color: Colors.white),
      ),
      // 🌟 ใช้ Stack ครอบเพื่อแสดงป้ายระยะทางทับบนแผนที่ใหญ่
      body: Stack(
        children: [
          FlutterMap(
            options: MapOptions(
              initialCameraFit: CameraFit.bounds(
                bounds: LatLngBounds.fromPoints([pointA, pointB]),
                padding: const EdgeInsets.all(
                  60.0,
                ), // เผื่อขอบหน้าจอใหญ่เยอะหน่อย
              ),
              interactionOptions: const InteractionOptions(
                flags: InteractiveFlag.all,
              ),
            ),
            children: [
              TileLayer(
                urlTemplate:
                    'https://api.maptiler.com/maps/streets-v2/256/{z}/{x}/{y}.png?key=$maptilerApiKey',
                userAgentPackageName: 'com.example.app',
              ),
              PolylineLayer(
                polylines: [
                  Polyline(
                    points: routePoints,
                    color: Colors.blue.shade400,
                    strokeWidth: 5.0,
                  ),
                ],
              ),
              MarkerLayer(
                markers: [
                  Marker(
                    point: pointA,
                    width: 40,
                    height: 40,
                    alignment: Alignment.topCenter,
                    child: _buildLargeMapPin(
                      'A',
                      const Color(0xFFA052BE),
                    ), // 🌟 หมุด A สีม่วง
                  ),
                  Marker(
                    point: pointB,
                    width: 40,
                    height: 40,
                    alignment: Alignment.topCenter,
                    child: _buildLargeMapPin(
                      'B',
                      Colors.black,
                    ), // 🌟 หมุด B สีดำ
                  ),
                ],
              ),
            ],
          ),

          // 🌟 5. ป้ายแสดงระยะทางบนมุมซ้ายบนของแผนที่ใหญ่
          Positioned(
            top: 20,
            left: 20,
            child: SafeArea(
              child: Container(
                padding: const EdgeInsets.symmetric(
                  horizontal: 16,
                  vertical: 10,
                ),
                decoration: BoxDecoration(
                  color: Colors.white.withOpacity(0.95),
                  borderRadius: BorderRadius.circular(25),
                  boxShadow: const [
                    BoxShadow(color: Colors.black26, blurRadius: 6),
                  ],
                ),
                child: Row(
                  mainAxisSize: MainAxisSize.min,
                  children: [
                    const Icon(
                      Icons.directions_car,
                      color: Color(0xFFA052BE),
                      size: 20,
                    ),
                    const SizedBox(width: 8),
                    Text(
                      distanceText,
                      style: const TextStyle(
